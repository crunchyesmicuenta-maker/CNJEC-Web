{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cnjec-web",
  "main": "server/site-worker.js",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "migrations": [
    {"tag": "enrollment-v1", "new_sqlite_classes": ["EnrollmentControl"]},
    {"tag": "remove-staff-access-v2", "deleted_classes": ["EnrollmentControl"]}
  ]
}
